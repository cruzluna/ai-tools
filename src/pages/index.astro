const withCategory = (category: ToolCategory, toolList: ToolSeed[]): Tool[] =>
  toolList.map((tool) => ({ ...tool, category }))

const tools: Tool[] = [
  ...withCategory("environment", environmentTools),
  ...withCategory("sandboxes", sandboxTools),
  ...withCategory("cli-tui", cliTuiTools),
  ...withCategory("agents-sdk", agentsSdkTools),
  ...withCategory("autonomous-agents", autonomousAgentsTools),
].sort((a, b) => a.name.localeCompare(b.name))

const categoryLabels: Record<ToolCategory, string> = {
  environment: "ADE",
  sandboxes: "Sandboxes",
  "cli-tui": "CLI/TUI",
  "agents-sdk": "Agents SDK",
  "autonomous-agents": "Autonomous Agents",
}

const filterPathById: Record<FilterId, string> = {
  all: "/",
  environment: "/environment",
  sandboxes: "/sandboxes",
  "cli-tui": "/cli-tui",
  "agents-sdk": "/agents-sdk",
  "autonomous-agents": "/autonomous-agents",
}

const normalizePathname = (pathname: string) =>
  pathname !== "/" && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname

const getFilterFromPathname = (pathname: string): FilterId => {
  const normalizedPath = normalizePathname(pathname)
  for (const [id, path] of Object.entries(filterPathById)) {
    if (path === normalizedPath) {
      return id as FilterId
    }
  }
  return "all"
}

const isVisibleForFilter = (tool: Tool, filter: FilterId) =>
  filter === "all" || tool.category === filter

const initialFilter = getFilterFromPathname(Astro.url.pathname)
const initialVisibilityByIndex = tools.map((tool) =>
  isVisibleForFilter(tool, initialFilter)
)
let initialListNumber = 0
const initialListNumbersByIndex = initialVisibilityByIndex.map((isVisible) => {
  if (!isVisible) {
    return ""
  }
  initialListNumber += 1
  return String(initialListNumber).padStart(2, "0")
})
const initialVisibleCount = tools.filter((tool) =>
  isVisibleForFilter(tool, initialFilter)
).length

const filterOptions = [
  { id: "all", label: "All", path: filterPathById.all, count: tools.length },
  {
    id: "environment",
    label: "ADE",
    path: filterPathById.environment,
    count: tools.filter((tool) => tool.category === "environment").length,
  },
  {
    id: "sandboxes",
    label: "Sandboxes",
    path: filterPathById.sandboxes,
    count: tools.filter((tool) => tool.category === "sandboxes").length,
  },
  {
    id: "cli-tui",
    label: "CLI/TUI",
    path: filterPathById["cli-tui"],
    count: tools.filter((tool) => tool.category === "cli-tui").length,
  },
  {
    id: "agents-sdk",
    label: "Agents SDK",
    path: filterPathById["agents-sdk"],
    count: tools.filter((tool) => tool.category === "agents-sdk").length,
  },
  {
    id: "autonomous-agents",
    label: "Autonomous Agents",
    path: filterPathById["autonomous-agents"],
    count: tools.filter((tool) => tool.category === "autonomous-agents").length,
  },
] satisfies Array<{ id: FilterId; label: string; path: string; count: number }>

const issueTitle = "Add missing AI tool: [Tool Name]"
const issueBody = `## Tool to add
- Name:
- Website:
- GitHub repo (if any):
- Optional \`githubStarsUrl\` (\`https://github.com/...\` only) when the listing \`url\` is not a repo path — otherwise stars use the GitHub \`url\`:

## Suggested prompt
Please add [TOOL NAME] to the tool list.

Requirements:
- Pull a short one-line description from the official site.
`
const newIssueUrl = `https://github.com/cruzluna/ai-tools/issues/new?title=${encodeURIComponent(issueTitle)}&body=${encodeURIComponent(issueBody)}`
