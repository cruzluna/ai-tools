type ToolCategory =
  | "environment"
  | "sandboxes"
  | "cli-tui"
  | "agents-sdk"
  | "autonomous-agents"
type FilterId = ToolCategory | "all"

type ToolSeed = {
  name: string
  url: string
  domain: string
  description: string
  languages?: string[]
  /**
   * Optional `https://github.com/...` URL for star counts when `url` is not a repo path
   * (e.g. product pages under `/features/...`). Type enforces the prefix.
   */
  githubStarsUrl?: GithubComHttpsUrl
}

type Tool = ToolSeed & {
  category: ToolCategory
}

function githubComTool(
  tool: Omit<ToolSeed, "domain"> & { url: GithubComHttpsUrl }
): ToolSeed {
  return { ...tool, domain: "github.com" }
}

const formatLanguages = (languages?: string[]) =>
  languages ? languages.join(", ") : ""

