<Layout title="AI Agent Environments">
  <main
    id="main-content"
    class="min-h-svh w-full bg-black text-white"
    tabindex="-1"
  >
    <div
      class="mx-auto grid w-full max-w-7xl gap-6 px-4 py-6 sm:gap-8 sm:px-8 sm:py-10 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-14 lg:px-10 lg:py-16"
    >
      <header class="min-w-0 lg:sticky lg:top-10 lg:self-start">
        <div class="lg:pb-0">
          <div class="mb-5 space-y-4 border-b border-zinc-900 pb-5 sm:mb-6 sm:space-y-5 lg:mb-10 lg:space-y-6 lg:border-b-0 lg:pb-0">
            <div class="space-y-3 lg:space-y-4">
              <div class="flex items-start justify-between gap-4">
                <p class="text-[0.65rem] tracking-[0.28em] text-zinc-500 uppercase">
                  Featured Tools
                </p>
                <p class="shrink-0 text-right text-[0.65rem] leading-snug text-zinc-500">
                  <span class="tracking-wide">Site</span>
                  <span class="mx-1 text-zinc-700" aria-hidden="true">
                    ·
                  </span>
                  <a
                    href="https://www.cruzluna.dev/"
                    target="_blank"
                    rel="noreferrer"
                    class="border-b border-zinc-600 text-zinc-300 transition-colors hover:border-zinc-400 hover:text-zinc-100 focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2 focus-visible:ring-offset-black focus-visible:outline-none"
                  >
                    cruzluna.dev
                  </a>
                </p>
              </div>
              <h1
                class="max-w-[22rem] text-balance text-3xl leading-[1.08] font-medium tracking-[-0.035em] text-zinc-50 sm:max-w-3xl sm:text-4xl sm:leading-[1.05] lg:max-w-none lg:text-[3.25rem] lg:leading-none"
              >
                Agent Development Environments
              </h1>
              <p class="max-w-md text-sm leading-relaxed text-zinc-400 sm:max-w-xl sm:text-[0.9375rem] sm:leading-7">
                A compact index of tools for building, running, and shipping
                with AI agents.
              </p>
            </div>

            <div
              class="flex items-baseline gap-2 border-y border-zinc-800 py-3 text-xs text-zinc-500 lg:py-3.5"
            >
              <p class="shrink-0 tracking-[0.18em] uppercase">Listed</p>
              <p
                data-tools-count
                class="min-w-0 truncate text-base leading-none font-medium tracking-tight text-zinc-100 tabular-nums"
              >
                {initialVisibleCount} tools
              </p>
            </div>
          </div>

          <div
            data-controls-root
            data-initial-filter={initialFilter}
            data-filter-paths={JSON.stringify(filterPathById)}
            class="sticky top-0 z-30 -mx-4 border-b border-zinc-900 bg-black px-4 py-2.5 sm:-mx-8 sm:px-8 lg:static lg:z-auto lg:mx-0 lg:border-0 lg:bg-transparent lg:px-0 lg:py-0"
          >
            <p class="mb-2 hidden tracking-[0.2em] text-zinc-600 uppercase lg:block">
              Filter
            </p>
            <nav
              aria-label="Tool filters"
              class="flex touch-pan-x snap-x snap-proximity gap-2 overflow-x-auto overscroll-x-contain [-ms-overflow-style:none] [scrollbar-width:none] lg:grid lg:snap-none lg:grid-cols-1 lg:gap-1.5 lg:overflow-visible [&::-webkit-scrollbar]:hidden"
            >
              {
                filterOptions.map((option) => (
                  <a
                    href={option.path}
                    data-filter-button={option.id}
                    aria-current={
                      option.id === initialFilter ? "page" : undefined
                    }
                    class:list={[
                      "flex max-lg:snap-start max-lg:shrink-0 max-lg:whitespace-nowrap items-center gap-2 border px-3 py-2 text-[0.65rem] tracking-wide uppercase transition-colors hover:border-zinc-500 hover:text-zinc-100 focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2 focus-visible:ring-offset-black focus-visible:outline-none max-lg:focus-visible:ring-offset-0 lg:w-full lg:justify-between lg:gap-0 lg:py-2.5 lg:text-xs",
                      option.id === initialFilter
                        ? "border-zinc-300 text-zinc-100"
                        : "border-zinc-800 text-zinc-500",
                    ]}
                  >
                    <span>{option.label}</span>
                    <span class="tabular-nums">
                      {String(option.count).padStart(2, "0")}
                    </span>
                  </a>
                ))
              }
            </nav>
          </div>
        </div>
      </header>

      <div class="min-w-0">
        <section
          data-view-panel="list"
          aria-label="Tools list view"
          class="border border-zinc-800 bg-zinc-950/30"
        >
          <div
            class="hidden grid-cols-[4.5rem_minmax(12rem,1fr)_minmax(18rem,2fr)_10rem] border-b border-zinc-800 px-5 py-3 text-xs tracking-[0.18em] text-zinc-500 uppercase md:grid"
          >
            <p>No.</p>
            <p>Tool</p>
            <p>Use</p>
            <p class="text-right">Type</p>
          </div>

          <ul role="list" class="divide-y divide-zinc-800">
            {
              tools.map((tool, index) => {
                const starsRepo = resolveGithubRepoForStars(tool)
                return (
                <li
                  data-tool-item
                  data-category={tool.category}
                  class:list={{
                    hidden: !initialVisibilityByIndex[index],
                  }}
                >
                  <a
                    href={tool.url}
                    target="_blank"
                    rel="noreferrer"
                    class="group grid gap-3 px-4 py-4 transition-[background-color,box-shadow] duration-150 hover:bg-black focus-visible:bg-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-500 focus-visible:ring-inset sm:gap-4 sm:px-5 sm:py-5 md:grid-cols-[4.5rem_minmax(12rem,1fr)_minmax(18rem,2fr)_10rem] md:items-start"
                  >
                    <p
                      data-list-number
                      class="text-xs text-zinc-600 tabular-nums md:pt-3"
                    >
                      {initialListNumbersByIndex[index]}
                    </p>

                    <div class="flex min-w-0 items-center gap-3">
                      <span class="flex size-11 shrink-0 items-center justify-center border border-zinc-800 bg-zinc-950 transition-[border-color] duration-150 group-hover:border-zinc-600">
                        <img
                          src={`https://www.google.com/s2/favicons?domain=${tool.domain}&sz=128`}
                          alt={`${tool.name} logo`}
                          loading="lazy"
                          class="size-6 grayscale"
                        />
                      </span>
                      <div class="min-w-0 space-y-0.5">
                        <p class="truncate text-base font-medium tracking-tight text-zinc-50">
                          {tool.name}
                        </p>
                        {starsRepo && (
                          <div class="min-w-0">
                            <GitHubStars
                              client:load
                              repo={starsRepo}
                            />
                          </div>
                        )}
                      </div>
                    </div>

                    <div class="space-y-1.5 md:space-y-2 md:pt-1.5">
                      <p class="text-sm leading-snug text-zinc-400 sm:leading-6">
                        {tool.description}
                      </p>
                      {tool.languages && (
                        <p class="text-xs leading-relaxed text-zinc-500">
                          Languages: {formatLanguages(tool.languages)}
                        </p>
                      )}
                    </div>

                    <p class="text-xs tracking-[0.18em] text-zinc-500 uppercase md:pt-3 md:text-right">
                      {categoryLabels[tool.category] ?? tool.category}
                    </p>
                  </a>
                </li>
                )
              })
            }
          </ul>
        </section>

        <footer
          class="mt-10 flex flex-wrap items-center justify-end gap-4 border-t border-zinc-900 pt-8"
        >
          <a
            href={newIssueUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="Missing? Opens GitHub in a new tab"
            title="Opens GitHub in a new tab"
            class="inline-flex items-center gap-1.5 border border-zinc-700 px-4 py-2 text-sm text-zinc-300 transition-colors hover:border-zinc-500 hover:text-zinc-100 focus-visible:ring-2 focus-visible:ring-zinc-400 focus-visible:ring-offset-2 focus-visible:ring-offset-black focus-visible:outline-none"
          >
            <span>Missing?</span>
            <span aria-hidden="true">↗</span>
          </a>
        </footer>
      </div>
    </div>

    <script>
      const controlsRoot = document.querySelector("[data-controls-root]")
      const listPanel = document.querySelector('[data-view-panel="list"]')

      if (controlsRoot && listPanel) {
        const filterPathById = JSON.parse(
          controlsRoot.dataset.filterPaths ?? "{}"
        )
        const initialFilterFromServer =
          controlsRoot.dataset.initialFilter ?? "all"
        const filterLinks = Array.from(
          controlsRoot.querySelectorAll("[data-filter-button]")
        )
        const listItems = Array.from(
          listPanel.querySelectorAll("[data-tool-item]")
        )
        const countLabels = document.querySelectorAll("[data-tools-count]")

        const normalizePathname = (pathname) =>
          pathname !== "/" && pathname.endsWith("/")
            ? pathname.slice(0, -1)
            : pathname

        const isKnownFilter = (filter) =>
          Object.prototype.hasOwnProperty.call(filterPathById, filter)

        const getFilterFromPathname = (pathname) => {
          const normalizedPath = normalizePathname(pathname)
          for (const [filter, path] of Object.entries(filterPathById)) {
            if (
              typeof path === "string" &&
              normalizePathname(path) === normalizedPath
            ) {
              return filter
            }
          }
          return "all"
        }

        const applyFilterLinkState = (links, activeFilter) => {
          for (const link of links) {
            const isActive = link.dataset.filterButton === activeFilter
            if (isActive) {
              link.setAttribute("aria-current", "page")
            } else {
              link.removeAttribute("aria-current")
            }
            link.classList.toggle("text-zinc-100", isActive)
            link.classList.toggle("text-zinc-500", !isActive)
            link.classList.toggle("border-zinc-300", isActive)
            link.classList.toggle("border-zinc-800", !isActive)
          }
        }

        const applyFilter = (filter) => {
          let visibleCount = 0
          let visibleIndex = 1

          for (const item of listItems) {
            const isVisible =
              filter === "all" || item.dataset.category === filter
            item.classList.toggle("hidden", !isVisible)

            if (isVisible) {
              const number = item.querySelector("[data-list-number]")
              if (number) {
                number.textContent = String(visibleIndex).padStart(2, "0")
              }
              visibleIndex += 1
              visibleCount += 1
            }
          }

          for (const label of countLabels) {
            label.textContent = `${visibleCount} tools`
          }

          applyFilterLinkState(filterLinks, filter)
        }

        const routeFilter = getFilterFromPathname(window.location.pathname)
        const initialFilter = isKnownFilter(routeFilter)
          ? routeFilter
          : isKnownFilter(initialFilterFromServer)
            ? initialFilterFromServer
            : "all"

        applyFilter(initialFilter)

        for (const link of filterLinks) {
          link.addEventListener("click", (event) => {
            if (event.defaultPrevented) {
              return
            }
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return
            }

            const nextFilter = link.dataset.filterButton ?? "all"
            if (!isKnownFilter(nextFilter)) {
              return
            }

            const nextPath =
              typeof filterPathById[nextFilter] === "string"
                ? filterPathById[nextFilter]
                : "/"
            event.preventDefault()
            applyFilter(nextFilter)

            if (
              normalizePathname(window.location.pathname) !==
              normalizePathname(nextPath)
            ) {
              window.history.pushState({ filter: nextFilter }, "", nextPath)
            }
          })
        }

        window.addEventListener("popstate", () => {
          const popFilter = getFilterFromPathname(window.location.pathname)
          applyFilter(isKnownFilter(popFilter) ? popFilter : "all")
        })
      }
    </script>
  </main>
</Layout>
